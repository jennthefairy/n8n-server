{"name": "PageFairy \u2014 Stuck Order Watchdog", "nodes": [{"id": "schedule-trigger", "name": "Every 60 Minutes", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [200, 300], "parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 60}]}}}, {"id": "get-stuck-orders", "name": "Get Stuck Orders (>24h)", "type": "n8n-nodes-base.airtable", "typeVersion": 2, "position": [400, 200], "parameters": {"resource": "record", "operation": "search", "base": {"__rl": true, "value": "appltMkhlKehBdR7w", "mode": "id"}, "table": {"__rl": true, "value": "ORDERS", "mode": "name"}, "filterByFormula": "=AND(NOT({state}=\"Delivered\"), NOT({state}=\"Released\"), NOT({state}=\"Refunded\"), DATETIME_DIFF(NOW(), {last_state_change}, 'hours') > 24)", "options": {}}, "credentials": {"airtableTokenApi": {"id": "uFomc3ydc8TCk7hH", "name": "Airtable API"}}}, {"id": "has-stuck-orders", "name": "Any Stuck Orders?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [600, 200], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "has-stuck", "leftValue": "={{ $json.length }}", "rightValue": 0, "operator": {"type": "number", "operation": "gt"}}], "combinator": "and"}, "options": {}}}, {"id": "loop-stuck", "name": "Loop Stuck Orders", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [800, 200], "parameters": {"batchSize": 1, "options": {}}}, {"id": "calc-stuck-hours", "name": "Compute Time Stuck", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1000, 200], "parameters": {"jsCode": "const order = $input.first().json;\nconst lastChange = order.fields.last_state_change ? new Date(order.fields.last_state_change) : null;\nconst now = new Date();\nconst hoursStuck = lastChange ? Math.floor((now - lastChange) / 3600000) : 'unknown';\nconst timeLabel = typeof hoursStuck === 'number' && hoursStuck >= 48\n  ? Math.floor(hoursStuck / 24) + ' days'\n  : hoursStuck + ' hours';\nreturn [{ json: {\n  order_id: order.id,\n  state: order.fields.state || 'unknown',\n  hours_stuck: hoursStuck,\n  time_label: timeLabel,\n  last_workflow: order.fields.workflow_name || 'none',\n  campaign_name: order.fields.campaign_name || order.fields.campaign_id || 'unknown',\n  customer_email: order.fields.customer_email || 'unknown',\n  fields: order.fields\n} }];"}}, {"id": "check-recent-alert", "name": "Check AUDIT_LOGS: Recent Alert?", "type": "n8n-nodes-base.airtable", "typeVersion": 2, "position": [1200, 200], "parameters": {"resource": "record", "operation": "search", "base": {"__rl": true, "value": "appltMkhlKehBdR7w", "mode": "id"}, "table": {"__rl": true, "value": "AUDIT_LOGS", "mode": "name"}, "filterByFormula": "=AND({target_id}=\"{{ $json.order_id }}\", {action}=\"watchdog_alert_sent\", DATETIME_DIFF(NOW(), {created_at}, 'hours') < 4)", "options": {}}, "credentials": {"airtableTokenApi": {"id": "uFomc3ydc8TCk7hH", "name": "Airtable API"}}}, {"id": "already-alerted", "name": "Already Alerted (4hr)?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1400, 200], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "alerted", "leftValue": "={{ $json.length }}", "rightValue": 0, "operator": {"type": "number", "operation": "equals"}}], "combinator": "and"}, "options": {}}}, {"id": "alert-stuck-admin", "name": "Alert Admin: Stuck Order", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1600, 200], "parameters": {"method": "POST", "url": "https://api.telegram.org/bot8515666300:AAGPX_M0u_5uTrp63O4nCbnovkK02e8-_08/sendMessage", "sendBody": true, "specifyBody": "json", "jsonBody": "={ {\n  \"chat_id\": \"7478195283\",\n  \"text\": \"\u26a0\ufe0f STUCK ORDER ALERT\\n\\n\"    + \"Order ID: \" + $('Compute Time Stuck').first().json.order_id + \"\\n\"\n    + \"State: \" + $('Compute Time Stuck').first().json.state + \"\\n\"\n    + \"Time in State: \" + $('Compute Time Stuck').first().json.time_label + \"\\n\"\n    + \"Last Workflow: \" + $('Compute Time Stuck').first().json.last_workflow + \"\\n\"\n    + \"Campaign: \" + $('Compute Time Stuck').first().json.campaign_name + \"\\n\"\n    + \"Customer: \" + $('Compute Time Stuck').first().json.customer_email + \"\\n\\n\"\n    + \"Action required \u2014 check Airtable.\"\n} }", "options": {}}}, {"id": "audit-stuck-alert", "name": "AUDIT: Watchdog Alert Sent", "type": "n8n-nodes-base.airtable", "typeVersion": 2, "position": [1800, 200], "parameters": {"resource": "record", "operation": "create", "base": {"__rl": true, "value": "appltMkhlKehBdR7w", "mode": "id"}, "table": {"__rl": true, "value": "AUDIT_LOGS", "mode": "name"}, "fields": {"fieldValues": [{"fieldName": "actor", "fieldValue": "watchdog"}, {"fieldName": "action", "fieldValue": "watchdog_alert_sent"}, {"fieldName": "target_type", "fieldValue": "orders"}, {"fieldName": "target_id", "fieldValue": "={{ $('Compute Time Stuck').first().json.order_id }}"}, {"fieldName": "details", "fieldValue": "={{ JSON.stringify({hours_stuck: $('Compute Time Stuck').first().json.hours_stuck, state: $('Compute Time Stuck').first().json.state}) }}"}]}}, "credentials": {"airtableTokenApi": {"id": "uFomc3ydc8TCk7hH", "name": "Airtable API"}}}, {"id": "get-ai-pending-90", "name": "Get AI_Pending Orders (T+90-120)", "type": "n8n-nodes-base.airtable", "typeVersion": 2, "position": [400, 420], "parameters": {"resource": "record", "operation": "search", "base": {"__rl": true, "value": "appltMkhlKehBdR7w", "mode": "id"}, "table": {"__rl": true, "value": "ORDERS", "mode": "name"}, "filterByFormula": "=AND({state}=\"AI_Pending\", DATETIME_DIFF(NOW(), {created_at}, 'minutes') > 90, DATETIME_DIFF(NOW(), {created_at}, 'minutes') < 120)", "options": {}}, "credentials": {"airtableTokenApi": {"id": "uFomc3ydc8TCk7hH", "name": "Airtable API"}}}, {"id": "has-t90-orders", "name": "Any T+90 Orders?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [600, 420], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "has-t90", "leftValue": "={{ $json.length }}", "rightValue": 0, "operator": {"type": "number", "operation": "gt"}}], "combinator": "and"}, "options": {}}}, {"id": "loop-t90", "name": "Loop T+90 Orders", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [800, 420], "parameters": {"batchSize": 1, "options": {}}}, {"id": "alert-t90-admin", "name": "Alert Admin: T+90 AI_Pending", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1000, 420], "parameters": {"method": "POST", "url": "https://api.telegram.org/bot8515666300:AAGPX_M0u_5uTrp63O4nCbnovkK02e8-_08/sendMessage", "sendBody": true, "specifyBody": "json", "jsonBody": "={ {\"chat_id\": \"7478195283\", \"text\": \"\u23f0 Order \" + $json.id + \" has been AI_Pending for 90 minutes. Review needed.\"} }", "options": {}}}, {"id": "get-ai-pending-120", "name": "Get AI_Pending Orders (T+120+)", "type": "n8n-nodes-base.airtable", "typeVersion": 2, "position": [400, 620], "parameters": {"resource": "record", "operation": "search", "base": {"__rl": true, "value": "appltMkhlKehBdR7w", "mode": "id"}, "table": {"__rl": true, "value": "ORDERS", "mode": "name"}, "filterByFormula": "=AND({state}=\"AI_Pending\", DATETIME_DIFF(NOW(), {created_at}, 'minutes') >= 120, {workflow_name}!=\"t120_auto_patience_msg\")", "options": {}}, "credentials": {"airtableTokenApi": {"id": "uFomc3ydc8TCk7hH", "name": "Airtable API"}}}, {"id": "has-t120-orders", "name": "Any T+120 Orders?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [600, 620], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"}, "conditions": [{"id": "has-t120", "leftValue": "={{ $json.length }}", "rightValue": 0, "operator": {"type": "number", "operation": "gt"}}], "combinator": "and"}, "options": {}}}, {"id": "loop-t120", "name": "Loop T+120 Orders", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [800, 620], "parameters": {"batchSize": 1, "options": {}}}, {"id": "get-customer-t120", "name": "Get Customer (T+120)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1000, 620], "parameters": {"jsCode": "const order = $input.first().json;\n// Look up user_id from order \u2014 passed through to next node\nreturn [{ json: {\n  order_id: order.id,\n  user_id: Array.isArray(order.fields.user_id) ? order.fields.user_id[0] : order.fields.user_id,\n  fields: order.fields\n} }];"}}, {"id": "lookup-user-t120", "name": "Lookup User for T+120", "type": "n8n-nodes-base.airtable", "typeVersion": 2, "position": [1200, 620], "parameters": {"resource": "record", "operation": "search", "base": {"__rl": true, "value": "appltMkhlKehBdR7w", "mode": "id"}, "table": {"__rl": true, "value": "USERS", "mode": "name"}, "filterByFormula": "=RECORD_ID()=\"{{ $json.user_id }}\"", "options": {}}, "credentials": {"airtableTokenApi": {"id": "uFomc3ydc8TCk7hH", "name": "Airtable API"}}}, {"id": "send-patience-msg", "name": "Send T+120 Patience Message", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.1, "position": [1400, 620], "parameters": {"method": "POST", "url": "https://api.telegram.org/bot8515666300:AAGPX_M0u_5uTrp63O4nCbnovkK02e8-_08/sendMessage", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ {\"chat_id\": $json[0].fields.telegram_chat_id, \"text\": \"High demand today \\u2014 your kit will be ready shortly. Thank you for your patience \\ud83e\\uddda \"} }}", "options": {}}}, {"id": "mark-t120-sent", "name": "Mark T+120 Sent", "type": "n8n-nodes-base.airtable", "typeVersion": 2, "position": [1600, 620], "parameters": {"resource": "record", "operation": "update", "base": {"__rl": true, "value": "appltMkhlKehBdR7w", "mode": "id"}, "table": {"__rl": true, "value": "ORDERS", "mode": "name"}, "id": "={{ $('Get Customer (T+120)').first().json.order_id }}", "fields": {"fieldValues": [{"fieldName": "workflow_name", "fieldValue": "t120_auto_patience_msg"}]}}, "credentials": {"airtableTokenApi": {"id": "uFomc3ydc8TCk7hH", "name": "Airtable API"}}}], "connections": {"Every 60 Minutes": {"main": [[{"node": "Get Stuck Orders (>24h)", "type": "main", "index": 0}, {"node": "Get AI_Pending Orders (T+90-120)", "type": "main", "index": 0}, {"node": "Get AI_Pending Orders (T+120+)", "type": "main", "index": 0}]]}, "Get Stuck Orders (>24h)": {"main": [[{"node": "Any Stuck Orders?", "type": "main", "index": 0}]]}, "Any Stuck Orders?": {"main": [[{"node": "Loop Stuck Orders", "type": "main", "index": 0}], []]}, "Loop Stuck Orders": {"main": [[{"node": "Compute Time Stuck", "type": "main", "index": 0}], []]}, "Compute Time Stuck": {"main": [[{"node": "Check AUDIT_LOGS: Recent Alert?", "type": "main", "index": 0}]]}, "Check AUDIT_LOGS: Recent Alert?": {"main": [[{"node": "Already Alerted (4hr)?", "type": "main", "index": 0}]]}, "Already Alerted (4hr)?": {"main": [[{"node": "Alert Admin: Stuck Order", "type": "main", "index": 0}], [{"node": "Loop Stuck Orders", "type": "main", "index": 0}]]}, "Alert Admin: Stuck Order": {"main": [[{"node": "AUDIT: Watchdog Alert Sent", "type": "main", "index": 0}]]}, "AUDIT: Watchdog Alert Sent": {"main": [[{"node": "Loop Stuck Orders", "type": "main", "index": 0}]]}, "Get AI_Pending Orders (T+90-120)": {"main": [[{"node": "Any T+90 Orders?", "type": "main", "index": 0}]]}, "Any T+90 Orders?": {"main": [[{"node": "Loop T+90 Orders", "type": "main", "index": 0}], []]}, "Loop T+90 Orders": {"main": [[{"node": "Alert Admin: T+90 AI_Pending", "type": "main", "index": 0}], []]}, "Alert Admin: T+90 AI_Pending": {"main": [[{"node": "Loop T+90 Orders", "type": "main", "index": 0}]]}, "Get AI_Pending Orders (T+120+)": {"main": [[{"node": "Any T+120 Orders?", "type": "main", "index": 0}]]}, "Any T+120 Orders?": {"main": [[{"node": "Loop T+120 Orders", "type": "main", "index": 0}], []]},